# KnowledgeOS - example environment file
#
# Copy to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env
#
# Values here are placeholders. Concrete settings are added as each
# component is chosen and implemented.

# ---- General -------------------------------------------------------------
APP_NAME=knowledgeos
APP_ENV=local
LOG_LEVEL=info

# ---- Paths (inside the container) ----------------------------------------
DATA_RAW_DIR=/data/raw
DATA_PROCESSED_DIR=/data/processed
DATA_INDEXES_DIR=/data/indexes
DATA_GENERATED_DIR=/data/generated

# ---- SEC EDGAR -----------------------------------------------------------
# SEC requires a descriptive User-Agent with a contact address.
# https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT="KnowledgeOS your.name@example.com"

# ---- Database ------------------------------------------------------------
# Engine not chosen yet.
# DATABASE_URL=

# ---- Vector store --------------------------------------------------------
# Engine not chosen yet.
# VECTOR_STORE_URL=

# ---- Model provider ------------------------------------------------------
# Provider not chosen yet. Keys belong in .env only.
# MODEL_PROVIDER=
# MODEL_API_KEY=
