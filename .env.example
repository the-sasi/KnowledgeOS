# KnowledgeOS - example environment file
#
# Copy to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env
#
# Every value below is a placeholder. `docker compose up -d` reads this file
# as .env; the marked variables have no default and compose will refuse to
# start without them.

# ---- General -------------------------------------------------------------
APP_NAME=knowledgeos
APP_ENV=local
LOG_LEVEL=info

# ---- Paths (inside the container) ----------------------------------------
DATA_RAW_DIR=/data/raw
DATA_PROCESSED_DIR=/data/processed
DATA_INDEXES_DIR=/data/indexes
DATA_GENERATED_DIR=/data/generated

# ---- SEC EDGAR -----------------------------------------------------------
# SEC requires a descriptive User-Agent with a contact address.
# https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT="KnowledgeOS your.name@example.com"

# ---- PostgreSQL (required) -----------------------------------------------
# Metadata and document store. Change the password before using this
# anywhere that is not your own machine.
POSTGRES_USER=knowledgeos
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=knowledgeos
# Host port. The container always listens on 5432 internally.
POSTGRES_PORT=5432

# Host used when DATABASE_URL is not set and the connection string is
# assembled from the parts above. The compose `app` service overrides this
# with the `postgres` service name.
POSTGRES_HOST=localhost

# Local folder bind-mounted as the Postgres data directory. Relative paths
# are resolved from the repo root. Git-ignored.
POSTGRES_DATA_DIR=./data/postgres

# Connection string for application code.
#   from the host       -> localhost:${POSTGRES_PORT}
#   from another service -> postgres:5432  (compose service name)
DATABASE_URL=postgresql://knowledgeos:change-me-local-only@localhost:5432/knowledgeos

# ---- Qdrant (vector store) -----------------------------------------------
# Host ports. The container always listens on 6333/6334 internally.
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_LOG_LEVEL=INFO

# Local folder bind-mounted as Qdrant's storage directory. Git-ignored.
QDRANT_DATA_DIR=./data/indexes/qdrant

# Endpoint for application code.
#   from the host       -> http://localhost:${QDRANT_HTTP_PORT}
#   from another service -> http://qdrant:6333  (compose service name)
VECTOR_STORE_URL=http://localhost:6333

# Built-in Qdrant web dashboard (no extra container needed):
#   http://localhost:${QDRANT_HTTP_PORT}/dashboard

# ---- Database browser (development only) ---------------------------------
# Adminer, a web UI for PostgreSQL. Started only with the "ui" profile:
#   docker compose --profile ui up -d
ADMINER_PORT=8080

# ---- Model provider ------------------------------------------------------
# Provider not chosen yet. Keys belong in .env only.
# MODEL_PROVIDER=
# MODEL_API_KEY=
